# Study Guard -- environment variables reference.
#
# There is no single .env for this whole repo -- frontend/ (Vite) and
# backend/ (Flask) each read their own env vars at their own build/run
# time. This file documents every variable that actually exists in the
# project; copy the relevant lines into frontend/.env or your cloud
# host's environment settings. Never commit real values -- see
# .gitignore.

# --- frontend/ (Vite / Vercel) ---
# Which Study Guard API the web app talks to. See frontend/.env.example
# for full guidance on which value to use.
VITE_API_BASE=

# --- backend/ (Flask, cloud deployment e.g. Render) ---
# Comma-separated list of origins allowed to call this API's /api/*
# routes via CORS (e.g. your Vercel URL). Left unset/"*", CORS is
# permissive -- fine for the desktop agent (loopback-only), NOT
# recommended for a public cloud deployment.
FRONTEND_URL=

# Writable, persistent directory for Study Guard's local state files
# (session_log.csv, roadmap_data.json, runtime_settings.json,
# live_state.json). Defaults to "." if unset. On the desktop agent,
# leave this unset. On a cloud host, point it at a persistent volume
# (see the root README's backend deployment notes) -- otherwise data
# will not survive a redeploy/restart.
DATA_DIR=

# Host/port Flask listens on when run directly (`python app.py`).
# Render and most PaaS providers set PORT for you automatically; HOST
# should stay 0.0.0.0 in the cloud so the platform's router can reach
# it (already the default in backend/app.py).
HOST=
PORT=
