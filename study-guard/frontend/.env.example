# Study Guard frontend -- environment variables (Vite)
#
# Copy this file to .env (local dev) or set the same key in Vercel's
# Project Settings -> Environment Variables (production). Never commit
# a real .env file -- see ../.gitignore.
#
# VITE_API_BASE controls which Study Guard API this frontend talks to.
# Leave it UNSET for local development (frontend/api.js already
# defaults to http://127.0.0.1:8000 in dev mode automatically).
#
# --- Typical values ---
#
# Local desktop agent (default, e.g. `python launcher.py` on your own
# machine) -- required for live webcam/posture/session features, since
# those only ever exist on the machine actually running the agent:
# VITE_API_BASE=http://127.0.0.1:8000
#
# Standalone cloud backend (e.g. deployed to Render -- see
# ../backend/README section in the root README) -- gives you the
# Roadmap / Settings / History / AI Coach pages without running the
# desktop agent, but Live Session / camera / posture will show
# "not running" since no local monitor is feeding it:
# VITE_API_BASE=https://your-backend-domain.example

VITE_API_BASE=
